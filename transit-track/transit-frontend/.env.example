# Copy this file to .env.local (git-ignored) and fill in the values.
# With VITE_API_URL unset, the app uses the mock data in src/lib/mockBuses.ts.

# Option A, simplest in development: send requests through Vite's dev server, which forwards
# them to the API. No CORS setup needed on the API.
VITE_API_URL=/api
API_PROXY_TARGET=http://localhost:8000

# Option B: call the API directly. The API must then allow this site's origin (CORS).
# VITE_API_URL=http://localhost:8000
